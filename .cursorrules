# .cursorrules – EasyFlow Continuous Learning Architecture

## Core Philosophy: Intelligent Automation That Learns

Every workflow and automation should be:

- **Observable**: Track what works and what doesn't
- **Measurable**: Quantify improvements over time
- **Adaptive**: Improve performance as it continues to exist
- **Resilient**: Degrade gracefully while learning

---

## Part 1: Continuous Learning Requirements

### 1.1 Every Automation Must Track Its Own Performance

```jsx
// Pattern: Instrumented Automation Workflow

class LearnableWorkflow {
  constructor(workflowId, workflowType) {
    this.workflowId = workflowId;
    this.workflowType = workflowType;
    this.metrics = {
      execution_count: 0,
      success_count: 0,
      error_count: 0,
      total_duration_ms: 0,
      avg_duration_ms: 0,
      error_patterns: {},
      performance_trend: [] // [timestamp, duration_ms]
    };
  }

  async execute(input) {
    const startTime = performance.now();
    const executionId = crypto.randomUUID();

    try {
      // Log execution start with learning context
      await this.logExecution('START', {
        workflow_id: this.workflowId,
        execution_id: executionId,
        input_hash: hashInput(input),
        timestamp: new Date().toISOString()
      });

      // Run the actual workflow
      const result = await this.runWorkflow(input);

      // Record success and update metrics
      const duration = performance.now() - startTime;
      this.metrics.execution_count++;
      this.metrics.success_count++;
      this.metrics.total_duration_ms += duration;
      this.metrics.avg_duration_ms = this.metrics.total_duration_ms / this.metrics.execution_count;
      this.metrics.performance_trend.push([Date.now(), duration]);

      // Log execution success with metrics
      await this.logExecution('SUCCESS', {
        workflow_id: this.workflowId,
        execution_id: executionId,
        duration_ms: duration,
        avg_duration_ms: this.metrics.avg_duration_ms,
        success_rate: (this.metrics.success_count / this.metrics.execution_count * 100).toFixed(2),
        timestamp: new Date().toISOString()
      });

      return result;

    } catch (error) {
      // Track error patterns for learning
      const duration = performance.now() - startTime;
      const errorType = error.constructor.name;
      
      this.metrics.execution_count++;
      this.metrics.error_count++;
      this.metrics.error_patterns[errorType] = (this.metrics.error_patterns[errorType] || 0) + 1;
      this.metrics.total_duration_ms += duration;
      this.metrics.avg_duration_ms = this.metrics.total_duration_ms / this.metrics.execution_count;

      // Log error with pattern analysis
      await this.logExecution('ERROR', {
        workflow_id: this.workflowId,
        execution_id: executionId,
        error_type: errorType,
        error_message: error.message,
        error_pattern_frequency: this.metrics.error_patterns[errorType],
        duration_ms: duration,
        timestamp: new Date().toISOString()
      });

      throw error;
    }
  }

  async runWorkflow(input) {
    // Implemented by subclass
    throw new Error('Must implement runWorkflow()');
  }

  async logExecution(status, context) {
    // Send to observability platform (New Relic)
    await newrelic.recordCustomEvent('WorkflowExecution', {
      ...context,
      status,
      workflow_type: this.workflowType
    });
  }

  getMetrics() {
    return {
      ...this.metrics,
      success_rate: (this.metrics.success_count / this.metrics.execution_count * 100).toFixed(2),
      error_rate: (this.metrics.error_count / this.metrics.execution_count * 100).toFixed(2),
      performance_stability: this.calculatePerformanceStability()
    };
  }

  calculatePerformanceStability() {
    // Detect if performance is improving or degrading
    const recent = this.metrics.performance_trend.slice(-10);
    const older = this.metrics.performance_trend.slice(0, Math.max(10, this.metrics.performance_trend.length - 20));
    
    if (recent.length === 0 || older.length === 0) return 'INSUFFICIENT_DATA';
    
    const recentAvg = recent.reduce((sum, [_, dur]) => sum + dur, 0) / recent.length;
    const olderAvg = older.reduce((sum, [_, dur]) => sum + dur, 0) / older.length;
    
    const percentChange = ((recentAvg - olderAvg) / olderAvg) * 100;
    
    if (Math.abs(percentChange) < 5) return 'STABLE';
    if (percentChange < -5) return 'IMPROVING';
    if (percentChange > 5) return 'DEGRADING';
  }
}
```

### 1.2 System-Level Learning Metrics

```jsx
// Every workflow must emit these metrics to New Relic

const LEARNING_METRICS = {
  // Performance metrics
  'workflow.execution.duration_ms': 'gauge',
  'workflow.execution.count': 'counter',
  'workflow.success_rate': 'gauge',
  'workflow.error_rate': 'gauge',
  
  // Learning metrics
  'workflow.performance_trend': 'gauge',  // Is it getting faster or slower?
  'workflow.error_pattern_frequency': 'gauge',  // Are we seeing the same errors?
  'workflow.success_stability': 'gauge',  // Is success rate consistent?
  
  // Adaptive metrics
  'workflow.retry_effectiveness': 'gauge',  // Do retries help?
  'workflow.cache_hit_rate': 'gauge',  // Is caching helping?
  'workflow.optimization_applied': 'counter',  // Track when AI optimized the workflow
};
```

### 1.3 Error Pattern Recognition

```jsx
// Detect and learn from recurring error patterns

class ErrorPatternAnalyzer {
  constructor() {
    this.patterns = {};
    this.threshold = 3; // Alert when error appears 3+ times in 24 hours
  }

  async analyzeErrors() {
    // Query New Relic for errors in past 24 hours
    const query = `
      SELECT 
        error.message,
        count(*) as frequency,
        percentile(duration, 95) as p95_duration,
        latest(timestamp) as most_recent
      FROM WorkflowExecution
      WHERE status = 'ERROR'
      SINCE 24 hours ago
      FACET error_type
    `;

    const results = await newrelic.queryNRQL(query);

    for (const errorType of Object.keys(results)) {
      const frequency = results[errorType].frequency;
      
      if (frequency >= this.threshold) {
        // Pattern detected - needs attention
        await this.createLearningTask({
          pattern: errorType,
          frequency,
          impact: 'HIGH',
          recommendation: `Investigate ${errorType} errors appearing ${frequency}x in 24h`
        });
      }
    }
  }
}
```

