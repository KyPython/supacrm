```sql
-- New Relic Dashboard: System Learning Health

SELECT 
  count(*) as total_executions,
  filter(count(*), WHERE status = 'SUCCESS') / count(*) * 100 as system_success_rate,
  percentile(duration_ms, 95) as p95_latency,
  uniqueCount(error_type) as unique_error_types,
  count(DISTINCT workflow_id) as active_workflows
FROM WorkflowExecution
SINCE 24 hours ago

-- Chart: Performance Trend (7 days)
SELECT 
  percentile(duration_ms, 95) as p95_duration
FROM WorkflowExecution
FACET DATE(timestamp)
SINCE 7 days ago

-- Chart: Error Pattern Frequency
SELECT 
  count(*) 
FROM WorkflowExecution
WHERE status = 'ERROR'
FACET error_type
SINCE 7 days ago
LIMIT 10
```

