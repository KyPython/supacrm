## Part 4: CI/CD Enforcement for Learning

### 4.1 Pre-Merge Checks for Observability

Add this to `.github/workflows/quality-gates.yml`:

```yaml
name: Learning & Observability Quality Gates

on: [pull_request]

jobs:
  learning-checks:
    runs-on: ubuntu-latest
    steps:
      # Check 1: Verify learning instrumentation
      - name: Check Observability Instrumentation
        run: |
          # Fail if PR adds new automation without learning hooks
          if grep -r "class.*Automation" src/ | grep -v "LearnableWorkflow"; then
            echo "❌ FAIL: New Automation must extend LearnableWorkflow"
            echo "Add observability instrumentation for continuous learning"
            exit 1
          fi
          echo "✅ PASS: All automations are observable"

      # Check 2: Verify metrics are being emitted
      - name: Verify Metrics Collection
        run: |
          # Fail if new workflow logic doesn't emit metrics
          if grep -A 10 "async execute" src/automations/*.js | grep -v "newrelic.recordCustomEvent"; then
            echo "❌ FAIL: Workflows must emit metrics via newrelic.recordCustomEvent"
            exit 1
          fi
          echo "✅ PASS: All workflows emit learning metrics"

      # Check 3: Verify error pattern tracking
      - name: Verify Error Handling & Learning
        run: |
          # Fail if catch blocks don't track error patterns
          if grep -A 5 "catch (error)" src/ | grep -v "error_patterns\\|error.constructor.name"; then
            echo "❌ FAIL: Error handling must track patterns for learning"
            echo "Implement: this.metrics.error_patterns[errorType]++"
            exit 1
          fi
          echo "✅ PASS: Error patterns are tracked"

      # Check 4: Verify performance monitoring
      - name: Verify Performance Tracking
        run: |
          # Fail if new code doesn't track step performance
          if grep -r "executeStep\|performance.now" src/ | wc -l | grep -q "^0$"; then
            echo "❌ FAIL: Critical paths must track execution time"
            exit 1
          fi
          echo "✅ PASS: Performance metrics are tracked"

      # Check 5: Verify learning insights are generated
      - name: Verify Learning Analysis
        run: |
          # Fail if new automations don't have learning analysis methods
          if grep -r "async execute" src/automations/*.js | grep -v "getLearningInsights\|analyzeWeeklyPerformance"; then
            echo "❌ FAIL: Automations must implement learning analysis"
            echo "Add: async getLearningInsights() method"
            exit 1
          fi
          echo "✅ PASS: Learning analysis is implemented"

      # Check 6: Verify New Relic integration
      - name: Verify New Relic Events
        run: |
          # Count all custom events being emitted
          EVENT_COUNT=$(grep -r "newrelic.recordCustomEvent" src/ | wc -l)
          echo "Found $EVENT_COUNT custom event emissions"
          if [ $EVENT_COUNT -lt 5 ]; then
            echo "⚠️  WARNING: Only $EVENT_COUNT custom events. Consider adding more learning metrics"
          else
            echo "✅ PASS: Sufficient learning metrics ($EVENT_COUNT events)"
          fi

      # Check 7: Verify data retention policy
      - name: Verify Data Retention for Learning
        run: |
          # Ensure we're keeping enough historical data for trends
          if grep -r "30 days ago\\|retention_policy" src/ | grep -q "retention_policy.*1 day"; then
            echo "❌ FAIL: Data retention too short for learning. Need at least 7 days"
            exit 1
          fi
          echo "✅ PASS: Data retention sufficient for learning trends"

      # Check 8: Verify anomaly detection hooks
      - name: Verify Anomaly Detection Hooks
        run: |
          # Fail if code doesn't have anomaly detection for critical paths
          if [ -z "$(grep -r "AnomalyDetector\|detectAnomalies" src/)" ]; then
            echo "⚠️  WARNING: No anomaly detection implemented"
            echo "Consider adding: new AnomalyDetector().detectAnomalies()"
          else
            echo "✅ PASS: Anomaly detection is active"
          fi

  learning-dashboard:
    runs-on: ubuntu-latest
    steps:
      # Check 9: Verify dashboard exists
      - name: Verify Learning Insights Dashboard
        run: |
          # Ensure New Relic dashboard is configured
          if [ -z "$(grep -r 'LEARNING_INSIGHTS_DASHBOARD' .env.example)" ]; then
            echo "⚠️  WARNING: Learning insights dashboard not referenced"
            echo "Add: LEARNING_INSIGHTS_DASHBOARD_ID in .env"
          else
            echo "✅ PASS: Learning dashboard is configured"
          fi

  test-learning-engine:
    runs-on: ubuntu-latest
    steps:
      # Check 10: Test learning metrics
      - name: Test Learning Engine
        run: |
          npm test -- learning.test.js
          if [ $? -ne 0 ]; then
            echo "❌ FAIL: Learning engine tests failed"
            exit 1
          fi
          echo "✅ PASS: Learning engine tests pass"

  report-learning-status:
    runs-on: ubuntu-latest
    if: always()
    steps:
      - name: Post Learning Status Check
        uses: actions/github-script@v6
        with:
          script: |
            const allPassed = context.job.status === 'success';
            const body = allPassed 
              ? '✅ All learning & observability checks PASSED'
              : '❌ Learning & observability checks FAILED - see logs';
            
            github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body
            });
```

### 4.2 Deployment Validation

```yaml
name: Post-Deployment Learning Verification

on: [deployment]

jobs:
  verify-learning-active:
    runs-on: ubuntu-latest
    steps:
      - name: Verify Learning Metrics Flow
        run: |
          # Query New Relic to confirm metrics are being received
          METRICS_COUNT=$(curl -s -H "Api-Key: ${{ secrets.NEWRELIC_API_KEY }}" \\
            "https://api.newrelic.com/graphql" \\
            -d '{"query": "{ actor { account(id: 1234567) { nrql(query: \"SELECT count(*) FROM WorkflowExecution SINCE 10 minutes ago\") { results } } } }"}' | jq '.data.actor.account.nrql.results[0].count')
          
          if [ "$METRICS_COUNT" -eq "0" ]; then
            echo "❌ FAIL: No learning metrics received in production"
            echo "Deployment may have broken observability"
            exit 1
          fi
          
          echo "✅ PASS: Learning metrics flowing ($METRICS_COUNT events in 10 min)"

      - name: Verify Error Tracking
        run: |
          # Ensure error patterns are being detected
          ERROR_COUNT=$(curl -s -H "Api-Key: ${{ secrets.NEWRELIC_API_KEY }}" \\
            "https://api.newrelic.com/graphql" \\
            -d '{"query": "{ actor { account(id: 1234567) { nrql(query: \"SELECT count(*) FROM WorkflowExecution WHERE status=\\'ERROR\\' SINCE 10 minutes ago\") { results } } } }"}' | jq '.data.actor.account.nrql.results[0].count')
          
          if [ "$ERROR_COUNT" -gt "5" ]; then
            echo "⚠️  WARNING: Error rate higher than normal ($ERROR_COUNT errors in 10 min)"
            echo "Anomaly detector should have alerted"
          else
            echo "✅ PASS: Error rate nominal"
          fi

      - name: Verify Anomaly Detection Active
        run: |
          # Check if anomaly detector is running
          ANOMALIES=$(curl -s -H "Api-Key: ${{ secrets.NEWRELIC_API_KEY }}" \\
            "https://api.newrelic.com/graphql" \\
            -d '{"query": "{ actor { account(id: 1234567) { nrql(query: \"SELECT count(*) FROM AnomalyDetection SINCE 1 hour ago\") { results } } } }"}' | jq '.data.actor.account.nrql.results[0].count')
          
          if [ "$ANOMALIES" -eq "0" ]; then
            echo "⚠️  WARNING: Anomaly detection not active"
          else
            echo "✅ PASS: Anomaly detection is running ($ANOMALIES checks in 1 hour)"
          fi
```

