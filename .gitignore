# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
*.swp
*.swo
*~
*.tmp
*.temp

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local

# database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# SQL files
*.sql
*.sql.dump
*.sql.bak
*.sql.backup
*.dump
*.bak
*.backup

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
.settings/

# Snyk Security Extension - AI Rules (auto-generated)
.cursor/rules/snyk_rules.mdc

# Ignore local Easy-Flow clone and sensitive AI prompt templates
/Easy-Flow-temp/
**/AI_PROMPT.md
**/AI_PROMPT*.md

# Ignore cursor and editor workspace files that may contain sensitive prompts
.cursor/
.vscode/
