*.tsbuildinfo
next-env.d.ts
.env.local

# database files
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal

# SQL dumps and backups (keep schema.sql and migration files)
*.sql.dump
*.sql.bak
*.sql.backup
*.dump
*.bak
*.backup
database/*.dump
database/*.bak
database/*.backup

# IDE files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
.classpath
